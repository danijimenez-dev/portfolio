import Services from '../components/sections/Services.astro';
import Projects from '../components/sections/Projects.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/layout/Footer.astro';
---

<Layout
  title="Daniel Jiménez | Desarrollador Web en Segovia"
  description="Diseño y desarrollo páginas web para negocios en Segovia. Webs rápidas, modernas y optimizadas para Google. Desde 300€. Respuesta en menos de 24 horas."
  isHome={true}
>
  <main id="main">
    <Hero />
    <Services />
    <Projects />
    <About />
    <Contact />
  </main>

  <Footer />
</Layout>
