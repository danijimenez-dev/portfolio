<footer class="site-footer">
  <div class="footer-inner">

    <!-- Bloque principal: tres columnas -->
    <div class="footer-grid">

      <!-- Columna 1: Identidad -->
      <div class="footer-col">
        <h3 class="col-heading">Daniel Jiménez</h3>
        <p class="col-tagline">Desarrollador web en Segovia</p>
        <div class="col-email">
          <span class="email-label">Email</span>
          <a href="mailto:hola@danijimenez.dev" class="email-link">
            hola@danijimenez.dev
          </a>
        </div>
      </div>

      <!-- Columna 2: Navegación -->
      <div class="footer-col">
        <h3 class="col-heading">Navegación</h3>
        <ul class="nav-list">
          <li><a href="#servicios" class="footer-link">Servicios</a></li>
          <li><a href="#proyectos" class="footer-link">Proyectos</a></li>
          <li><a href="#sobre-mi" class="footer-link">Sobre mí</a></li>
          <li><a href="#contacto" class="footer-link">Contacto</a></li>
        </ul>
      </div>

      <!-- Columna 3: Redes -->
      <div class="footer-col">
        <h3 class="col-heading">Redes</h3>
        <a
          href="https://github.com/danijimenez-dev"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Perfil de GitHub de Daniel Jiménez (se abre en pestaña nueva)"
          class="social-link"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
          <span>GitHub</span>
        </a>
        <!-- TODO: LinkedIn (URL pendiente) -->
        <!-- TODO: WhatsApp (número pendiente) -->
      </div>

    </div>

    <!-- Banda inferior: copyright y legales -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; 2026 Daniel Jiménez. Todos los derechos reservados.
      </p>
      <nav aria-label="Navegación legal">
        <ul class="legal-links">
          <li><a href="/aviso-legal" class="legal-link">Aviso legal</a></li>
          <li aria-hidden="true" class="legal-sep">&middot;</li>
          <li><a href="/politica-de-privacidad" class="legal-link">Política de privacidad</a></li>
        </ul>
      </nav>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    padding: 4rem 0 2rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  /* Grid de tres columnas */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Headings de columna */
  .col-heading {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .col-tagline {
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
    margin: 0;
  }

  /* Email */
  .col-email {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .email-label {
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
  }

  .email-link {
    font-size: 0.9375rem;
    color: var(--color-text);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .email-link:hover {
    color: var(--color-accent);
  }

  .email-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* Nav de footer */
  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-link {
    font-size: 0.9375rem;
    color: var(--color-text);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* Enlace de red social */
  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-text);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .social-link:hover {
    color: var(--color-accent);
  }

  .social-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }

  /* Banda inferior */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .copyright {
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-text) 60%, transparent);
    margin: 0;
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .legal-sep {
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-text) 40%, transparent);
  }

  .legal-link {
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-text) 60%, transparent);
    text-decoration: none;
    transition: color 150ms ease, opacity 150ms ease;
  }

  .legal-link:hover {
    color: var(--color-accent);
    opacity: 1;
  }

  .legal-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: var(--radius-sm);
  }
</style>
