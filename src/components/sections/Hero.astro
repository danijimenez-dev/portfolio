---
import { Image } from 'astro:assets';
import heroBg from '../../assets/hero-bg.jpg';
---

<section id="hero" class="hero-section">

  <div class="hero-background">
    <Image
      src={heroBg}
      alt=""
      widths={[768, 1024, 1440, 1920]}
      sizes="100vw"
      class="hero-image"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero-overlay"></div>

  <div class="hero-content">

    <div class="badge" role="status">
      <span class="badge-dot" aria-hidden="true"></span>
      Disponible para nuevos proyectos
    </div>

    <h1 class="hero-title">
      Páginas web para negocios locales en Segovia.
    </h1>

    <p class="hero-lead">
      Desarrollo webs rápidas, claras y que funcionan.
      Sin plantillas genéricas ni sorpresas.
      Solo lo que tu negocio necesita para destacar online.
    </p>

    <div class="hero-actions">
      <a href="#contacto" class="btn-primary">
        Hablemos de tu proyecto
      </a>
      <a href="#proyectos" class="btn-secondary">
        Ver proyectos
      </a>
    </div>

  </div>
</section>

<style>
  /*
   * margin-top negativo cancela el body { padding-top: 5.5rem } de global.css
   * para que la imagen arranque en y=0 y quede detrás del header flotante.
   */
  .hero-section {
    position: relative;
    overflow: hidden;
    margin-top: -5.5rem;
  }

  /* Imagen de fondo: capa 0 */
  .hero-background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Overlay oscuro: capa 1 */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.6) 50%,
      rgba(0, 0, 0, 0.7) 100%
    );
  }

  /*
   * Contenido: capa 2.
   * Este div es el que establece la altura mínima de toda la sección
   * y centra verticalmente el texto. El padding-top de 6rem asegura
   * que el contenido no quede tapado por el header de 4.5rem.
   */
  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 90vh;
    text-align: center;
    padding: 7rem 1.5rem 4rem;
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    gap: 1.75rem;
  }

  @media (max-width: 640px) {
    .hero-content {
      min-height: 85vh;
      padding: 7rem 1.25rem 3rem;
    }
  }

  /* Badge */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 100px;
    padding: 0.375rem 0.875rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: #ffffff;
  }

  .badge-dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #22c55e;
    flex-shrink: 0;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(0.85);
    }
  }

  /* Título */
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: #ffffff;
    margin: 0;
  }

  /* Lead */
  .hero-lead {
    max-width: 600px;
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
  }

  /* Botones */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms ease, transform 200ms ease, color 200ms ease;
  }

  .btn-primary:focus-visible,
  .btn-secondary:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  /* Primario */
  .btn-primary {
    background-color: var(--color-accent);
    color: #ffffff;
    border: 1.5px solid var(--color-accent);
  }

  .btn-primary:hover {
    background-color: color-mix(in srgb, var(--color-accent) 90%, #000000);
    transform: translateY(-1px);
  }

  /* Secundario */
  .btn-secondary {
    background-color: transparent;
    color: #ffffff;
    border: 1.5px solid rgba(255, 255, 255, 0.6);
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }
</style>
