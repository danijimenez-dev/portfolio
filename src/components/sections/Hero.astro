---
---

<section
  id="hero"
  class="hero-section"
>
  <div class="hero-content">

    <div class="badge" role="status">
      <span class="badge-dot" aria-hidden="true"></span>
      Disponible para nuevos proyectos
    </div>

    <h1 class="hero-title">
      Páginas web para negocios locales en Segovia.
    </h1>

    <p class="hero-lead">
      Desarrollo webs rápidas, claras y que funcionan.
      Sin plantillas genéricas ni sorpresas.
      Solo lo que tu negocio necesita para destacar online.
    </p>

    <div class="hero-actions">
      <a href="#contacto" class="btn-primary">
        Hablemos de tu proyecto
      </a>
      <a href="#proyectos" class="btn-secondary">
        Ver proyectos
      </a>
    </div>

  </div>
</section>

<style>
  .hero-section {
    min-height: 90vh;
    display: flex;
    align-items: center;
    background-color: var(--color-bg);
    padding: 5rem 1.5rem;
  }

  @media (max-width: 640px) {
    .hero-section {
      min-height: auto;
      padding: 4rem 1.25rem;
    }
  }

  .hero-content {
    width: 100%;
    max-width: 72rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  /* Badge */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    padding: 0.375rem 0.875rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .badge-dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #22c55e;
    flex-shrink: 0;
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.55;
      transform: scale(0.85);
    }
  }

  /* Título */
  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-text);
    margin: 0;
  }

  /* Lead */
  .hero-lead {
    max-width: 600px;
    font-size: 1.125rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-text) 80%, transparent);
    margin: 0;
  }

  /* Botones */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 200ms ease, transform 200ms ease, color 200ms ease;
  }

  /* Focus visible compartido */
  .btn-primary:focus-visible,
  .btn-secondary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Primario */
  .btn-primary {
    background-color: var(--color-accent);
    color: #ffffff;
    border: 1.5px solid var(--color-accent);
  }

  .btn-primary:hover {
    background-color: color-mix(in srgb, var(--color-accent) 90%, #000000);
    transform: translateY(-1px);
  }

  /* Secundario */
  .btn-secondary {
    background-color: transparent;
    color: var(--color-text);
    border: 1.5px solid var(--color-text);
  }

  .btn-secondary:hover {
    background-color: color-mix(in srgb, var(--color-text) 5%, transparent);
  }
</style>
